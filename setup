#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────
# Apple-Bug-Bounty-Skill — Interactive Setup
# Supports: Linux, macOS
# Configures: Claude Code, Cursor, Codex, OpenCode,
#              Windsurf, Copilot, Gemini, Qwen, Kimi
# ─────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

SKILL_DIR="$HOME/.apple-bug-bounty-skill"
REPO_URL="https://github.com/kaffeindecaf/Apple-Bug-Bounty-Skill.git"
PROGRESS_WIDTH=30

# ─────────────────────────────────────────────────
# WOLF BANNER
# ─────────────────────────────────────────────────

show_banner() {
    echo -e "${BOLD}          Apple-Bug-Bounty-Skill Setup${NC}"
    echo -e "${CYAN}    10 skills · 8 options · 9 agents · 0 fluff${NC}"
    echo ""
}

# ─────────────────────────────────────────────────
# UTILITY FUNCTIONS
# ─────────────────────────────────────────────────

log_info()  { echo -e "  ${BLUE}[INFO]${NC}  $1"; }
log_ok()    { echo -e "  ${GREEN}[OK]${NC}    $1"; }
log_warn()  { echo -e "  ${YELLOW}[WARN]${NC}  $1"; }
log_err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
log_step()  { echo -e "\n${BOLD}${CYAN}─── $1 ───${NC}"; }

# ─────────────────────────────────────────────────
# PROGRESS BAR
# ─────────────────────────────────────────────────

draw_progress_bar() {
    local current=$1 total=$2 title="$3"
    local pct=$((current * 100 / total))
    local filled=$((pct * PROGRESS_WIDTH / 100))
    local empty=$((PROGRESS_WIDTH - filled))
    local bar=""
    local i
    for ((i = 0; i < filled; i++)); do bar+="█"; done
    for ((i = 0; i < empty; i++)); do bar+="░"; done
    printf "\r  [%s] %s %3d%%" "$bar" "$title" "$pct"
}

# ─────────────────────────────────────────────────
# GIT CLONE WITH PROGRESS BAR
# ─────────────────────────────────────────────────

clone_with_progress() {
    local url="$1" dest="$2"
    local tmpfile
    tmpfile=$(mktemp /tmp/abb-install.XXXXXX)

    log_info "Cloning $url into $dest ..."
    echo ""

    git clone --progress --depth 1 "$url" "$dest" 2>"$tmpfile" &
    local pid=$!

    local chars="/-\|" i=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ -f "$tmpfile" ] && [ -s "$tmpfile" ]; then
            local last_line
            last_line=$(tail -1 "$tmpfile" 2>/dev/null || true)
            if [[ "$last_line" =~ ([0-9]+)% ]]; then
                local pct="${BASH_REMATCH[1]}"
                draw_progress_bar "$pct" 100 "Cloning"
            else
                printf "\r  ${BLUE}[%s]${NC} Cloning..." "${chars:i++%4:1}"
            fi
        else
            printf "\r  ${BLUE}[%s]${NC} Cloning..." "${chars:i++%4:1}"
        fi
        sleep 0.15
    done
    printf "\r\033[K"
    wait "$pid"
    local rc=$?
    rm -f "$tmpfile"
    if [ $rc -ne 0 ]; then
        log_err "Clone failed (exit code: $rc)"
        return 1
    fi
    draw_progress_bar 100 100 "Cloning"
    echo ""
    log_ok "Repository cloned successfully"
    return 0
}

# ─────────────────────────────────────────────────
# GIT PULL WITH PROGRESS BAR
# ─────────────────────────────────────────────────

pull_with_progress() {
    local workdir="$1"
    local tmpfile
    tmpfile=$(mktemp /tmp/abb-install.XXXXXX)

    (
        cd "$workdir"
        git pull --ff-only origin main 2>"$tmpfile"
    ) &
    local pid=$!

    local chars="/-\|" i=0
    while kill -0 "$pid" 2>/dev/null; do
        if [ -f "$tmpfile" ] && [ -s "$tmpfile" ]; then
            local last_line
            last_line=$(tail -1 "$tmpfile" 2>/dev/null || true)
            if [[ "$last_line" =~ ([0-9]+)% ]]; then
                local pct="${BASH_REMATCH[1]}"
                draw_progress_bar "$pct" 100 "Updating"
            else
                printf "\r  ${BLUE}[%s]${NC} Updating..." "${chars:i++%4:1}"
            fi
        else
            printf "\r  ${BLUE}[%s]${NC} Updating..." "${chars:i++%4:1}"
        fi
        sleep 0.15
    done
    printf "\r\033[K"
    wait "$pid"
    local rc=$?
    rm -f "$tmpfile"
    if [ $rc -ne 0 ]; then
        log_warn "Pull may have had issues (exit code: $rc), continuing"
    fi
    draw_progress_bar 100 100 "Updating"
    echo ""
    log_ok "Repository updated"
    return 0
}

# ─────────────────────────────────────────────────
# SYSTEM DETECTION
# ─────────────────────────────────────────────────

detect_os() {
    case "$(uname -s)" in
        Linux*)  OS="linux";  PKG_MGR="apt-get";;
        Darwin*) OS="macos";  PKG_MGR="brew";;
        *)       log_err "Unsupported OS: $(uname -s)"; exit 1;;
    esac
    log_info "Detected OS: ${OS} ($(uname -m))"
    log_info "Package manager: ${PKG_MGR}"
}

check_deps() {
    log_step "Checking System Dependencies"
    local missing=()

    for cmd in git curl; do
        if command -v "$cmd" &>/dev/null; then
            log_ok "$cmd found: $(command -v "$cmd")"
        else
            log_warn "$cmd not found"
            missing+=("$cmd")
        fi
    done

    if command -v python3 &>/dev/null; then
        log_ok "python3 found: $(python3 --version 2>&1)"
    else
        log_warn "python3 not found (needed for XPF/TSS/activation scripts)"
        missing+=("python3")
    fi

    if command -v gh &>/dev/null; then
        log_ok "gh (GitHub CLI) found: $(gh --version 2>&1 | head -1)"
    else
        log_warn "gh not found (needed for PR contributions)"
        missing+=("gh")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo ""
        log_warn "Missing packages: ${missing[*]}"
        read -rp "  Install them now? [Y/n] " answer
        if [[ "$answer" =~ ^[Nn] ]]; then
            log_info "Skipping. You may need to install them manually later."
        else
            if [ "$PKG_MGR" = "brew" ]; then
                for pkg in "${missing[@]}"; do
                    log_info "Installing $pkg via brew..."
                    brew install "$pkg" 2>/dev/null || log_warn "Failed to install $pkg via brew"
                done
            else
                log_info "Installing via apt-get..."
                sudo apt-get update -qq && sudo apt-get install -y -qq "${missing[@]}" 2>/dev/null || log_warn "Failed to install some packages"
            fi
        fi
    fi
}

# ─────────────────────────────────────────────────
# AGENT DETECTION
# ─────────────────────────────────────────────────

AGENTS=()
declare -A AGENT_NAMES AGENT_CONFIGS AGENT_PATHS AGENT_DETECT AGENT_IDX

detect_agents() {
    log_step "Detecting Installed AI Agents"
    AGENTS=()

    # Claude Code
    if command -v claude &>/dev/null; then
        AGENTS+=("claude")
        AGENT_NAMES["claude"]="Claude Code"
        AGENT_CONFIGS["claude"]=".claude/instructions.md"
        AGENT_PATHS["claude"]="$HOME/.claude"
        AGENT_DETECT["claude"]="cli at: $(command -v claude)"
        log_ok "Claude Code detected — ${AGENT_DETECT["claude"]}"
    else
        log_info "Claude Code not detected (install: npm install -g @anthropic-ai/claude-code)"
    fi

    # Cursor
    if command -v cursor &>/dev/null || [ -d "/Applications/Cursor.app" ] || [ -d "$HOME/Applications/Cursor.app" ]; then
        AGENTS+=("cursor")
        AGENT_NAMES["cursor"]="Cursor"
        AGENT_CONFIGS["cursor"]=".cursorrules"
        AGENT_PATHS["cursor"]="$SKILL_DIR"
        AGENT_DETECT["cursor"]="app detected"
        log_ok "Cursor detected"
    else
        log_info "Cursor not detected (download: https://cursor.com)"
    fi

    # OpenAI Codex
    if command -v codex &>/dev/null; then
        AGENTS+=("codex")
        AGENT_NAMES["codex"]="OpenAI Codex"
        AGENT_CONFIGS["codex"]=".codex.md"
        AGENT_PATHS["codex"]="$HOME/.codex"
        AGENT_DETECT["codex"]="cli at: $(command -v codex)"
        log_ok "OpenAI Codex detected — ${AGENT_DETECT["codex"]}"
    else
        log_info "OpenAI Codex not detected (install: npm install -g @openai/codex)"
    fi

    # OpenCode
    local opencode_version="unknown"
    if command -v opencode &>/dev/null; then
        opencode_version=$(opencode --version 2>/dev/null || echo "unknown")
        AGENTS+=("opencode")
        AGENT_NAMES["opencode"]="OpenCode"
        AGENT_CONFIGS["opencode"]="opencode.json"
        AGENT_PATHS["opencode"]="$SKILL_DIR"
        AGENT_DETECT["opencode"]="cli at: $(command -v opencode) (v${opencode_version})"
        log_ok "OpenCode detected — ${AGENT_DETECT["opencode"]}"
    else
        log_info "OpenCode not detected (see: https://opencode.ai)"
    fi

    # Windsurf
    if command -v windsurf &>/dev/null || [ -d "/Applications/Windsurf.app" ] || [ -d "$HOME/Applications/Windsurf.app" ]; then
        AGENTS+=("windsurf")
        AGENT_NAMES["windsurf"]="Windsurf"
        AGENT_CONFIGS["windsurf"]=".windsurfrules"
        AGENT_PATHS["windsurf"]="$SKILL_DIR"
        AGENT_DETECT["windsurf"]="app detected"
        log_ok "Windsurf detected"
    else
        log_info "Windsurf not detected (download: https://codeium.com/windsurf)"
    fi

    # GitHub Copilot
    if command -v gh &>/dev/null && gh extension list 2>/dev/null | grep -q "copilot"; then
        AGENTS+=("copilot")
        AGENT_NAMES["copilot"]="GitHub Copilot"
        AGENT_CONFIGS["copilot"]=".github/copilot-instructions.md"
        AGENT_PATHS["copilot"]="$SKILL_DIR"
        AGENT_DETECT["copilot"]="gh extension detected"
        log_ok "GitHub Copilot detected"
    else
        log_info "GitHub Copilot CLI not detected (install: gh extension install github/gh-copilot)"
    fi

    # Gemini
    if command -v gemini &>/dev/null || [ -f "$HOME/.gemini/config.json" ]; then
        AGENTS+=("gemini")
        AGENT_NAMES["gemini"]="Google Gemini"
        AGENT_CONFIGS["gemini"]="GEMINI.md"
        AGENT_PATHS["gemini"]="$HOME/.gemini"
        AGENT_DETECT["gemini"]="cli detected"
        log_ok "Gemini detected"
    else
        log_info "Gemini CLI not detected (see: https://github.com/google-gemini/gemini-cli)"
    fi

    # Qwen
    AGENTS+=("qwen")
    AGENT_NAMES["qwen"]="Alibaba Qwen"
    AGENT_CONFIGS["qwen"]="qwen-extension.json"
    AGENT_PATHS["qwen"]="$SKILL_DIR"
    AGENT_DETECT["qwen"]="always available (config-only)"

    # Kimi
    AGENTS+=("kimi")
    AGENT_NAMES["kimi"]="Moonshot Kimi"
    AGENT_CONFIGS["kimi"]="kimi.plugin.json"
    AGENT_PATHS["kimi"]="$SKILL_DIR"
    AGENT_DETECT["kimi"]="always available (config-only)"

    echo ""
    log_info "Found ${#AGENTS[@]} compatible agent(s) to configure"
}

# ─────────────────────────────────────────────────
# INTERACTIVE AGENT SELECTION
# ─────────────────────────────────────────────────

select_agents() {
    log_step "Select Agents to Configure"

    echo ""
    echo -e "  ${BOLD}Available agents:${NC}"
    echo ""

    local idx=1
    for key in "${!AGENT_IDX[@]}"; do unset 'AGENT_IDX[$key]'; done
    for agent in "${AGENTS[@]}"; do
        local name="${AGENT_NAMES[$agent]}"
        local detect="${AGENT_DETECT[$agent]}"
        printf "  ${BOLD}%2d)${NC} %-25s ${CYAN}%s${NC}\n" "$idx" "$name" "$detect"
        AGENT_IDX[$idx]="$agent"
        ((idx++))
    done

    echo ""
    echo -e "  ${BOLD} a)${NC}  All of the above"
    echo -e "  ${BOLD} q)${NC}  Quit without configuring"
    echo ""

    read -rp "  Your choice (space-separated numbers, 'a' for all, or 'q'): " selection

    if [[ "$selection" == "q" ]]; then
        echo ""
        log_info "No agents configured. Run this script again anytime."
        exit 0
    fi

    SELECTED_AGENTS=()
    if [[ "$selection" == "a" ]]; then
        SELECTED_AGENTS=("${AGENTS[@]}")
    else
        for num in $selection; do
            if [[ -n "${AGENT_IDX[$num]:-}" ]]; then
                SELECTED_AGENTS+=("${AGENT_IDX[$num]}")
            fi
        done
    fi

    echo ""
    log_info "Will configure:"
    for agent in "${SELECTED_AGENTS[@]}"; do
        echo -e "    - ${GREEN}${AGENT_NAMES[$agent]}${NC}"
    done
    echo ""

    read -rp "  Proceed? [Y/n] " confirm
    if [[ "$confirm" =~ ^[Nn] ]]; then
        log_info "Aborted. Run this script again anytime."
        exit 0
    fi
}

# ─────────────────────────────────────────────────
# OPencode SKILL SETUP
# ─────────────────────────────────────────────────

setup_opencode_skills() {
    log_step "Setting Up OpenCode Skill Discovery"
    log_info "OpenCode discovers skills from:"
    log_info "  (global)  ~/.config/opencode/skills/<name>/SKILL.md"
    log_info "  (project) <project>/.opencode/skills/<name>/SKILL.md"
    log_info "Creating symlinks for global + project-local skill discovery..."

    local skills_dir="$SKILL_DIR/.opencode/skills"
    local global_skills_dir="$HOME/.config/opencode/skills"
    rm -rf "$skills_dir"
    mkdir -p "$skills_dir"
    mkdir -p "$global_skills_dir"

    # Map of skill name -> relative path to the actual skill file
    declare -A SKILL_MAP
    SKILL_MAP["master-router"]="$SKILL_DIR/SKILL.md"
    SKILL_MAP["ios-kernel-exploit"]="$SKILL_DIR/skills/ios-kernel-exploit.md"
    SKILL_MAP["ios-sandbox-escape"]="$SKILL_DIR/skills/ios-sandbox-escape.md"
    SKILL_MAP["ios-security-pentesting"]="$SKILL_DIR/skills/ios-security-pentesting.md"
    SKILL_MAP["ios-misc-tooling"]="$SKILL_DIR/skills/ios-misc-tooling.md"
    SKILL_MAP["ios-bootchain-exploit"]="$SKILL_DIR/skills/ios-bootchain-exploit.md"
    SKILL_MAP["ios-code-injection"]="$SKILL_DIR/skills/ios-code-injection.md"
    SKILL_MAP["ios-webkit-exploit"]="$SKILL_DIR/skills/ios-webkit-exploit.md"
    SKILL_MAP["ios-puaf-exploit"]="$SKILL_DIR/skills/ios-puaf-exploit.md"
    SKILL_MAP["ios-coretrust-bypass"]="$SKILL_DIR/skills/ios-coretrust-bypass.md"
    SKILL_MAP["ios-research-methodology"]="$SKILL_DIR/skills/ios-research-methodology.md"

    local total=${#SKILL_MAP[@]}
    local count=0

    for name in "${!SKILL_MAP[@]}"; do
        local src="${SKILL_MAP[$name]}"
        local dstdir="$skills_dir/$name"
        local global_dstdir="$global_skills_dir/$name"
        mkdir -p "$dstdir" "$global_dstdir"

        if [ -f "$src" ]; then
            ln -sf "$src" "$dstdir/SKILL.md"
            ln -sf "$src" "$global_dstdir/SKILL.md"
            count=$((count + 1))
            draw_progress_bar "$count" "$total" "Linking skills"
        else
            log_warn "Skill source not found: $src"
        fi
    done

    echo ""
    log_ok "Created $count OpenCode skill symlinks in $skills_dir"
    log_ok "Created $count OpenCode skill symlinks in $global_skills_dir"
    log_info "Skills are now available globally in OpenCode (any project)."

    # Back up existing opencode.json at the target if it exists
    local target_json="$SKILL_DIR/opencode.json"
    if [ -f "$target_json" ]; then
        local backup="$target_json.bak.$(date +%s)"
        cp "$target_json" "$backup"
        log_info "Backed up existing opencode.json to $backup"
    fi

    # Ensure opencode.json at the target has valid format
    # The repo's opencode.json is already valid (just $schema)
    # Skills are auto-discovered from .opencode/skills/ — no extra config needed
    log_ok "OpenCode skill discovery configured"
}

# ─────────────────────────────────────────────────
# SKILL INSTALLATION
# ─────────────────────────────────────────────────

clone_or_update_repo() {
    log_step "Setting Up Skill Repository"

    if [ -d "$SKILL_DIR/.git" ]; then
        log_info "Repository exists at $SKILL_DIR"
        pull_with_progress "$SKILL_DIR"
    else
        # Handle interrupted clone — remove stale dir without .git
        if [ -d "$SKILL_DIR" ]; then
            log_warn "$SKILL_DIR exists but is not a git repository"
            read -rp "  Remove it and re-clone? [Y/n] " answer
            if [[ "$answer" =~ ^[Nn] ]]; then
                log_err "Cannot continue with a non-git directory. Aborting."
                exit 1
            fi
            rm -rf "$SKILL_DIR"
            log_info "Removed stale directory"
        fi
        clone_with_progress "$REPO_URL" "$SKILL_DIR"
    fi

    log_info "Verifying repository integrity..."
    local required=(
        "SKILL.md"
        "opencode.json"
        "offsets.yaml"
        "options/SYSTEM.md"
        "skills/ios-kernel-exploit.md"
        "skills/ios-sandbox-escape.md"
        "skills/ios-security-pentesting.md"
        "skills/ios-misc-tooling.md"
        "skills/ios-bootchain-exploit.md"
        "skills/ios-code-injection.md"
        "skills/ios-webkit-exploit.md"
        "skills/ios-puaf-exploit.md"
        "skills/ios-coretrust-bypass.md"
        "skills/ios-research-methodology.md"
    )

    local total_verify=${#required[@]}
    local verify_count=0
    local verify_errors=0

    for f in "${required[@]}"; do
        if [ -f "$SKILL_DIR/$f" ]; then
            verify_count=$((verify_count + 1))
        else
            log_err "Missing: $f — repository may be corrupted"
            verify_errors=$((verify_errors + 1))
        fi
        draw_progress_bar "$verify_count" "$total_verify" "Verifying"
    done
    echo ""

    if [ "$verify_errors" -gt 0 ]; then
        log_warn "$verify_errors file(s) missing"
    else
        log_ok "All $total_verify required files verified"
    fi
}

configure_agent() {
    local agent="$1"
    local total="$2"
    local idx="$3"
    local name="${AGENT_NAMES[$agent]}"
    local config="${AGENT_CONFIGS[$agent]}"
    local path="${AGENT_PATHS[$agent]}"

    draw_progress_bar "$idx" "$total" "Configuring $name"
    echo ""

    local src="$SKILL_DIR/$config"
    if [ ! -f "$src" ]; then
        log_err "Config file not found: $src"
        return 1
    fi

    case "$agent" in
        claude)
            mkdir -p "$HOME/.claude"
            cp "$src" "$HOME/.claude/instructions.md"
            log_ok "Copied $config → $HOME/.claude/instructions.md"
            log_info "Claude Code will auto-load this on session start"
            ;;

        cursor)
            log_info "Cursor auto-ingests .cursorrules from the workspace directory."
            log_info "Open $SKILL_DIR as a workspace in Cursor to activate."
            log_info "Skills available via: @skills/ios-kernel-exploit.md (etc.)"
            ;;

        codex)
            mkdir -p "$HOME/.codex"
            cp "$src" "$HOME/.codex/instructions.md"
            log_ok "Copied $config → $HOME/.codex/instructions.md"
            log_info "Run: codex --instructions $HOME/.codex/instructions.md"
            ;;

        opencode)
            log_info "OpenCode discovers skills from ~/.config/opencode/skills/<name>/SKILL.md"
            log_info "Skills are symlinked globally — available in every project."
            log_info "Project-local copies also live at $SKILL_DIR/.opencode/skills/"
            ;;

        windsurf)
            log_info "Windsurf auto-ingests .windsurfrules from the workspace directory."
            log_info "Open $SKILL_DIR as a workspace in Windsurf to activate."
            ;;

        copilot)
            mkdir -p "$SKILL_DIR/.github"
            cp "$src" "$SKILL_DIR/.github/copilot-instructions.md"
            log_ok "Copied $config"
            log_info "GitHub Copilot will use these instructions on this repo."
            ;;

        gemini)
            mkdir -p "$HOME/.gemini"
            cp "$src" "$HOME/.gemini/"
            log_ok "Copied $config → $HOME/.gemini/GEMINI.md"
            log_info "Gemini will use this as an extension."
            ;;

        qwen|kimi)
            log_info "$name plugin config is at: $src"
            log_info "Import this file in $name's plugin settings."
            ;;
    esac

    log_ok "$name configured successfully"
    echo ""
}

verify_setup() {
    log_step "Verifying Setup"

    echo ""
    echo -e "  ${BOLD}Configured agents:${NC}"
    for agent in "${SELECTED_AGENTS[@]}"; do
        local name="${AGENT_NAMES[$agent]}"
        local config="${AGENT_CONFIGS[$agent]}"

        case "$agent" in
            claude)
                if [ -f "$HOME/.claude/instructions.md" ]; then
                    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %s\n" "$name" "$HOME/.claude/instructions.md"
                else
                    printf "  ${RED}\xE2\x9C\x97${NC} %-25s %s\n" "$name" "config missing"
                fi
                ;;
            cursor|windsurf|opencode|qwen|kimi|gemini|copilot)
                if [ -f "$SKILL_DIR/$config" ]; then
                    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %s\n" "$name" "$SKILL_DIR/$config"
                else
                    printf "  ${RED}\xE2\x9C\x97${NC} %-25s %s\n" "$name" "config missing"
                fi
                ;;
            codex)
                if [ -f "$HOME/.codex/instructions.md" ]; then
                    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %s\n" "$name" "$HOME/.codex/instructions.md"
                else
                    printf "  ${RED}\xE2\x9C\x97${NC} %-25s %s\n" "$name" "config missing"
                fi
                ;;
        esac
    done

    echo ""
    echo -e "  ${BOLD}Skill files:${NC}"
    local skill_count
    skill_count=$(find "$SKILL_DIR/skills" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    local option_count
    option_count=$(find "$SKILL_DIR/options" -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
    local opencode_skill_count=0
    if [ -d "$SKILL_DIR/.opencode/skills" ]; then
        opencode_skill_count=$(find "$SKILL_DIR/.opencode/skills" -name "SKILL.md" -type l 2>/dev/null | wc -l | tr -d ' ')
    fi
    local global_opencode_skill_count=0
    if [ -d "$HOME/.config/opencode/skills" ]; then
        global_opencode_skill_count=$(find "$HOME/.config/opencode/skills" -name "SKILL.md" -type l 2>/dev/null | wc -l | tr -d ' ')
    fi
    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %d skills loaded\n" "Skill modules:" "$skill_count"
    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %d options available\n" "Output options:" "$option_count"
    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %d OpenCode skills linked\n" "OpenCode discovery:" "$opencode_skill_count"
    printf "  ${GREEN}\xE2\x9C\x93${NC} %-25s %d global links in ~/.config/opencode/skills\n" "OpenCode global:" "$global_opencode_skill_count"

    echo ""
    echo -e "  ${BOLD}Quick test commands:${NC}"
    for agent in "${SELECTED_AGENTS[@]}"; do
        case "$agent" in
            claude)   echo -e "    ${CYAN}claude${NC} \"Load ios-kernel-exploit skill\"" ;;
            cursor)   echo -e "    ${CYAN}cursor${NC} $SKILL_DIR   (open workspace)" ;;
            codex)    echo -e "    ${CYAN}codex${NC} --instructions $HOME/.codex/instructions.md" ;;
            opencode) echo -e "    ${CYAN}opencode${NC}                                 (skills auto-discovered globally)" ;;
            windsurf) echo -e "    ${CYAN}windsurf${NC} $SKILL_DIR    (open workspace)" ;;
            *)        echo -e "    ${CYAN}$agent${NC}: config ready at $SKILL_DIR/$config" ;;
        esac
    done
}

# ─────────────────────────────────────────────────
