    echo -e "${BOLD}${GREEN}\xE2\x95\x91          Setup Complete                      \xE2\x95\x91${NC}"
    echo -e "${BOLD}${GREEN}\xE2\x95\x9A\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x90\xE2\x95\x9D${NC}"
    echo ""
    echo -e "  Skills location: ${CYAN}$SKILL_DIR${NC}"
    echo -e "  Agents configured: ${GREEN}${#SELECTED_AGENTS[@]}${NC}"
    echo ""
    echo -e "  ${BOLD}Options to try:${NC}"
    echo -e "    ${YELLOW}--adhd${NC}       ADHD-friendly, action-first output"
    echo -e "    ${YELLOW}--verbose${NC}    Maximum detail, all offsets, full code"
    echo -e "    ${YELLOW}--thinking${NC}   Deep chain-of-thought, multiple hypotheses"
    echo -e "    ${YELLOW}--new${NC}        Audit mode, rank findings critical-to-low"
    echo -e "    ${YELLOW}--idea${NC}       Project/feature idea generator"
    echo -e "    ${YELLOW}--bug${NC}        Bug checker -> writes foundbugs.md"
    echo -e "    ${YELLOW}--fix${NC}        Bug fixer (chained from --bug)"
    echo -e "    ${YELLOW}--cash${NC}       Money-focused ideas + career paths"
    echo ""
    echo -e "  ${BOLD}To contribute back:${NC}"
    echo -e "    Fork ${CYAN}$REPO_URL${NC}"
    echo -e "    Run ${CYAN}gh pr create --repo kaffeindecaf/Apple-Bug-Bounty-Skill${NC}"
    echo ""
}

# ─────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────

main() {
    show_banner
    detect_os
    check_deps
    detect_agents

    if [ ${#AGENTS[@]} -eq 0 ]; then
        log_err "No AI agents detected on this system."
        log_info "You can still clone the repository: git clone $REPO_URL"
        log_info "Then manually load SKILL.md into your preferred agent."
        exit 1
    fi

    select_agents

    if [ ${#SELECTED_AGENTS[@]} -eq 0 ]; then
        log_info "Nothing to configure. Goodbye."
        exit 0
    fi

    clone_or_update_repo

    # Set up OpenCode skill discovery if OpenCode is selected
    local opencode_selected=false
    for agent in "${SELECTED_AGENTS[@]}"; do
        if [ "$agent" = "opencode" ]; then
            opencode_selected=true
            break
        fi
    done
    if $opencode_selected; then
        setup_opencode_skills
    fi

    # Configure each agent with progress
    echo ""
    log_step "Configuring Agents"
    echo ""

    local total_agents=${#SELECTED_AGENTS[@]}
    local agent_idx=0

    for agent in "${SELECTED_AGENTS[@]}"; do
        agent_idx=$((agent_idx + 1))
        configure_agent "$agent" "$total_agents" "$agent_idx"
    done

    draw_progress_bar "$total_agents" "$total_agents" "All agents configured"
    echo ""
    echo ""

    verify_setup
    show_summary
}

main "$@"
