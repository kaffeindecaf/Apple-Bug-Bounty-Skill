#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────
# Apple-Bug-Bounty-Skill — Uninstaller
# Supports: Linux, macOS
# Removes: skill repo, OpenCode global skill links,
#          agent config files created by ./setup
# ─────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

SKILL_DIR="$HOME/.apple-bug-bounty-skill"

SKILL_NAMES=(
    "master-router"
    "ios-kernel-exploit"
    "ios-sandbox-escape"
    "ios-security-pentesting"
    "ios-misc-tooling"
    "ios-bootchain-exploit"
    "ios-code-injection"
    "ios-webkit-exploit"
    "ios-puaf-exploit"
    "ios-coretrust-bypass"
    "ios-research-methodology"
)

log_info()  { echo -e "  ${BLUE}[INFO]${NC}  $1"; }
log_ok()    { echo -e "  ${GREEN}[OK]${NC}    $1"; }
log_warn()  { echo -e "  ${YELLOW}[WARN]${NC}  $1"; }
log_err()   { echo -e "  ${RED}[ERROR]${NC} $1"; }
log_step()  { echo -e "\n${BOLD}${CYAN}─── $1 ───${NC}"; }

# ─────────────────────────────────────────────────
# REMOVE OPENCODE GLOBAL SKILL LINKS
# ─────────────────────────────────────────────────

remove_opencode_skills() {
    log_step "Removing OpenCode Skill Links"
    local global_skills_dir="$HOME/.config/opencode/skills"
    local removed=0

    if [ -d "$global_skills_dir" ]; then
        for name in "${SKILL_NAMES[@]}"; do
            local dir="$global_skills_dir/$name"
            if [ -L "$dir/SKILL.md" ]; then
                rm -f "$dir/SKILL.md"
                rmdir "$dir" 2>/dev/null || true
                removed=$((removed + 1))
                log_ok "Removed $name"
            fi
        done
    else
        log_info "No global OpenCode skills directory found"
    fi

    if [ "$removed" -gt 0 ]; then
        log_ok "Removed $removed global skill link(s)"
    else
        log_info "No OpenCode skill links found"
    fi
}

# ─────────────────────────────────────────────────
# REMOVE AGENT CONFIG FILES
# ─────────────────────────────────────────────────

remove_agent_configs() {
    log_step "Removing Agent Config Files"

    local files=(
        "$HOME/.claude/instructions.md"
        "$HOME/.codex/instructions.md"
        "$HOME/.gemini/GEMINI.md"
    )
    local labels=(
        "Claude Code instructions"
        "OpenAI Codex instructions"
        "Google Gemini extension"
    )

    for i in "${!files[@]}"; do
        local f="${files[$i]}"
        local label="${labels[$i]}"
        if [ -f "$f" ]; then
            if grep -q "Apple-Bug-Bounty-Skill" "$f" 2>/dev/null; then
                rm -f "$f"
                log_ok "Removed $label ($f)"
            else
                log_warn "Skipping $f — does not look like an Apple-Bug-Bounty-Skill file"
            fi
        else
            log_info "$label not present"
        fi
    done
}

# ─────────────────────────────────────────────────
# REMOVE SKILL REPOSITORY
# ─────────────────────────────────────────────────

remove_repository() {
    log_step "Removing Skill Repository"

    if [ -d "$SKILL_DIR" ]; then
        log_info "Found repository at $SKILL_DIR"
        read -rp "  Remove the repository and all its contents? [y/N] " answer
        if [[ "$answer" =~ ^[Yy] ]]; then
            rm -rf "$SKILL_DIR"
            log_ok "Removed $SKILL_DIR"
        else
            log_info "Kept repository at $SKILL_DIR"
        fi
    else
        log_info "Repository not found at $SKILL_DIR"
    fi
}

# ─────────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────────

main() {
    echo -e "${BOLD}          Apple-Bug-Bounty-Skill Uninstall${NC}"
    echo -e "${CYAN}        Removes skills, links, and configs${NC}"
    echo ""

    log_info "This will remove everything installed by ./setup"
    echo ""

    read -rp "  Continue? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy] ]]; then
        log_info "Aborted. Nothing was removed."
        exit 0
    fi

    remove_opencode_skills
    remove_agent_configs
    remove_repository

    echo ""
    echo -e "${BOLD}${GREEN}          Uninstall Complete${NC}"
    echo ""
    echo -e "  Note: project-local copies (.opencode/skills inside"
    echo -e "  a cloned repo) are removed with the repository."
    echo ""
}

main "$@"
