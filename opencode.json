{
  "name": "apple-bug-bounty-skill",
  "version": "4.0.0",
  "description": "iOS exploit development knowledge base. 10 specialized skill modules with options pipeline (--adhd, --verbose, --thinking, --new), cross-referencing, and research-first protocol.",
  "author": "kaffeindecaf",
  "license": "MIT",
  "options": {
    "system": "options/SYSTEM.md",
    "adhd": {
      "id": "options-adhd",
      "file": "options/adhd.md",
      "trigger": "--adhd",
      "description": "ADHD-friendly output. Action first, numbered steps, no preamble, no fluff."
    },
    "verbose": {
      "id": "options-verbose",
      "file": "options/verbose.md",
      "trigger": "--verbose",
      "description": "Maximum detail. Full offsets, code snippets, alternatives, caveats."
    },
    "thinking": {
      "id": "options-thinking",
      "file": "options/thinking.md",
      "trigger": "--thinking",
      "description": "Deep chain-of-thought. Multiple hypotheses, higher token budget."
    },
    "new": {
      "id": "options-new",
      "file": "options/new.md",
      "trigger": "--new",
      "description": "Audit mode. Scans target, finds bugs, recommends skills, ranks findings."
    },
    "idea": {
      "id": "options-idea",
      "file": "options/idea.md",
      "trigger": "--idea",
      "description": "Project/feature idea generator. Empty dirs get project ideas, existing code gets feature ideas."
    },
    "bug": {
      "id": "options-bug",
      "file": "options/bug.md",
      "trigger": "--bug",
      "description": "Bug checker. Scans using 10 bug classes, writes to foundbugs.md, chains to --fix.",
      "chains_to": "--fix"
    },
    "fix": {
      "id": "options-fix",
      "file": "options/fix.md",
      "trigger": "--fix",
      "description": "Bug fixer. Fixes bugs from foundbugs.md one at a time, critical first.",
      "chained_from": "--bug"
    },
    "cash": {
      "id": "options-cash",
      "file": "options/cash.md",
      "trigger": "--cash",
      "description": "Money-focused idea generator. Ranks ideas by earning potential ($$$/$$/$)."
    }
  },
  "skills": [
    {
      "id": "master-router",
      "name": "Master Router",
      "file": "SKILL.md",
      "always_load": true
    },
    {
      "id": "ios-kernel-exploit",
      "name": "iOS Kernel Exploit",
      "file": "skills/ios-kernel-exploit.md"
    },
    {
      "id": "ios-sandbox-escape",
      "name": "iOS Sandbox Escape",
      "file": "skills/ios-sandbox-escape.md"
    },
    {
      "id": "ios-security-pentesting",
      "name": "iOS Security Pentesting",
      "file": "skills/ios-security-pentesting.md"
    },
    {
      "id": "ios-misc-tooling",
      "name": "iOS Tooling & Workflow",
      "file": "skills/ios-misc-tooling.md"
    },
    {
      "id": "ios-bootchain-exploit",
      "name": "iOS Bootchain Exploit",
      "file": "skills/ios-bootchain-exploit.md"
    },
    {
      "id": "ios-code-injection",
      "name": "iOS Code Injection",
      "file": "skills/ios-code-injection.md"
    },
    {
      "id": "ios-webkit-exploit",
      "name": "iOS WebKit Exploit",
      "file": "skills/ios-webkit-exploit.md"
    },
    {
      "id": "ios-puaf-exploit",
      "name": "iOS PUAF Exploit",
      "file": "skills/ios-puaf-exploit.md"
    },
    {
      "id": "ios-coretrust-bypass",
      "name": "iOS CoreTrust Bypass",
      "file": "skills/ios-coretrust-bypass.md"
    },
    {
      "id": "ios-research-methodology",
      "name": "iOS Research Methodology",
      "file": "skills/ios-research-methodology.md"
    }
  ],
  "agent_compatibility": {
    "claude-code": { "config": ".claude/instructions.md", "auto_load": true },
    "cursor": { "config": ".cursorrules", "auto_load": true },
    "codex": { "config": ".codex.md", "auto_load": true },
    "opencode": { "config": "opencode.json", "auto_load": true },
    "windsurf": { "config": ".windsurfrules", "auto_load": true },
    "copilot": { "config": ".github/copilot-instructions.md", "auto_load": true },
    "gemini": { "config": "GEMINI.md", "auto_load": true },
    "qwen": { "config": "qwen-extension.json", "auto_load": true },
    "kimi": { "config": "kimi.plugin.json", "auto_load": true }
  }
}
